<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cantos arredondados do design system. Ver docs/design-system.md. -->

    <style name="ShapeAppearance.RiftTracker.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/corner_sm</item>
    </style>

    <style name="ShapeAppearance.RiftTracker.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/corner_md</item>
    </style>

    <style name="ShapeAppearance.RiftTracker.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/corner_lg</item>
    </style>

    <!-- Pill: usado em chips de rank e região. -->
    <style name="ShapeAppearance.RiftTracker.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Topo do bottom sheet: só os cantos de cima são arredondados. -->
    <style name="ShapeAppearance.RiftTracker.SheetTop" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSizeTopLeft">@dimen/corner_xl</item>
        <item name="cornerSizeTopRight">@dimen/corner_xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
