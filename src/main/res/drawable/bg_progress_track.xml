<?xml version="1.0" encoding="utf-8"?>
<!--
  Trilho da barra de winrate: cantos arredondados nos dois lados, cor de
  base = derrota. O segmento de vitória é uma View filha com peso
  proporcional ao win% por cima (ver Widget.RiftTracker.WinrateBar e o
  exemplo de uso no README) — o quanto dela cobre é o que faz a barra
  "encher", a cor de fundo aqui só aparece na parte que sobra (derrota).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/rift_loss" />
    <corners android:radius="3dp" />
</shape>
